# Copy to .env (ignored by Git). scripts/install.sh creates .env and fills the local values automatically.
# Never put secrets in NEXT_PUBLIC_* variables or commit them. The browser only ever calls same-origin /api.

APP_ENV=development
# Exact browser origins allowed to make state-changing requests (scheme://host[:port], comma-separated).
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local PostgreSQL cluster managed by scripts/run.py (127.0.0.1:55432). In production use the managed URL;
# postgres:// and postgresql:// URLs are accepted and converted to the psycopg driver automatically.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://internmatch:CHANGE_ME@127.0.0.1:55432/internmatch
PG_BIN=/opt/homebrew/opt/postgresql@17/bin

# SECRET. Fernet key encrypting profiles, resumes and evaluations. Back it up; losing it makes data unreadable.
# Generate once: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DATA_ENCRYPTION_KEY=

# AI provider: disabled | ollama | openai. Disabled never fabricates output (postings stay Unverified).
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENCY=1
# Local runtime: no API key. Plain HTTP only to loopback, or to hosts listed in OLLAMA_ALLOWED_HTTP_HOSTS.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOWED_HTTP_HOSTS=
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=10m

# Optional hosted provider (OpenAI-compatible, HTTPS only). Used as primary with AI_PROVIDER=openai, or as a
# fallback only when AI_ALLOW_HOSTED_FALLBACK=true AND AI_FALLBACK_PROVIDER=openai. Sends documents off-device.
AI_ALLOW_HOSTED_FALLBACK=false
AI_FALLBACK_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Public ATS board identifiers (configuration, not secrets), comma-separated, from employers' official career links.
GREENHOUSE_BOARDS=
LEVER_SITES=
DISCOVERY_INTERVAL_SECONDS=21600

# Optional email digests (STARTTLS with certificate validation). SMTP_PASSWORD is a secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
